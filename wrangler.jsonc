{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payamake-contact-staging",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payamake-db-staging",
      "database_id": "abf3e568-c0ee-4efc-ac35-bfb6f8d9af1e"
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
